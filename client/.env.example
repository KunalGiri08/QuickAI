# QuickAI Client Environment Configuration

# Clerk Publishable Key (From Clerk Dashboard -> API Keys)
# Required for frontend authentication and session management
VITE_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key

# Backend API Base URL
# Local development default: http://localhost:3000
# Production: https://api.yourdomain.com (without trailing slash)
VITE_BASE_URL=http://localhost:3000
